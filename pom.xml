<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.paulsens</groupId>
    <artifactId>trip-manager-parent</artifactId>
    <packaging>pom</packaging>
    <version>1.0-SNAPSHOT</version>
    <name>Trip Organizer</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jacoco.version>0.8.15</jacoco.version>
    </properties>

    <modules>
        <module>jsft</module>
        <module>trip</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Netty BOM first so every io.netty artifact (AWS SDK's and Lettuce's) resolves to ONE version.
                 Must stay on the 4.1 line: the AWS SDK requires Netty 4.1 (even in its newest releases), while
                 Lettuce 7.x requires Netty 4.2 (which is why lettuce-core is pinned to 6.x below). Mixing the
                 two Netty lines fails at runtime (AbstractMethodError in netty-buffer). -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>4.1.136.Final</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>2.48.1</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Jackson BOM: coordinates all jackson-* artifact versions together -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>2.21.5</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Jetty BOM: reaches the classpath only through DynamoDBLocal (test scope), which pins 12.0.14,
                 a version with four Dependabot CVEs (request smuggling, gzip memory leak, trailer
                 cross-request leakage, path traversal). Nothing here uses Jetty directly; this only lifts the
                 test classpath onto the patched line. -->
            <dependency>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-bom</artifactId>
                <version>12.0.36</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- POI's commons-compress asks for the (CVE-2025-48924-patched) 3.18.0, but Maven's
                 nearest-wins mediation was answering 3.17.0 from a shorter path. Pinned so the RUNTIME
                 classpath gets the patched version whatever the tree shape does next. -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>3.18.0</version>
            </dependency>
            <!-- log4j-api rides in at compile scope via POI; log4j-core is a test dependency of the trip
                 module (DynamoDBLocal needs a modern core). The two MUST move together (a core newer than
                 the api dies with NoSuchMethodError in LoaderUtil while DynamoDB Local boots), so both are
                 held here at the Dependabot-patched version. -->
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-api</artifactId>
                <version>2.25.4</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-core</artifactId>
                <version>2.25.4</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>2.0.17</version>
                <scope>compile</scope>
            </dependency>
            <!-- Valkey/Redis client for the shared cache layer (async, CompletableFuture-native).
                 Stay on the 6.x line until the AWS SDK moves to Netty 4.2 (see netty-bom note above). -->
            <dependency>
                <groupId>io.lettuce</groupId>
                <artifactId>lettuce-core</artifactId>
                <version>6.8.2.RELEASE</version>
            </dependency>
            <!-- Password hashing (BCrypt). Self-contained, pure Java, no meaningful transitive dependencies;
                 bundles at.favre.lib:bytes. See org.paulsens.trip.security.PasswordHasher. -->
            <dependency>
                <groupId>at.favre.lib</groupId>
                <artifactId>bcrypt</artifactId>
                <version>0.10.2</version>
            </dependency>
            <!-- Passkeys (WebAuthn relying-party verification). Dependency-light: SLF4J + Jackson (the
                 jackson-bom above manages its cbor/jdk8 modules to our version). Deliberately NOT
                 webauthn-server-attestation: attestation metadata is enterprise machinery this site does not
                 want (AttestationConveyancePreference.NONE). Crypto comes from the JDK's own providers. -->
            <dependency>
                <groupId>com.yubico</groupId>
                <artifactId>webauthn-server-core</artifactId>
                <version>2.7.0</version>
            </dependency>
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-classic</artifactId>
                <version>1.5.34</version>
            </dependency>
            <dependency>
                <groupId>jakarta.enterprise</groupId>
                <artifactId>jakarta.enterprise.cdi-api</artifactId>
                <version>4.1.0</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>org.jboss.weld.servlet</groupId>
                <artifactId>weld-servlet-shaded</artifactId>
                <version>6.0.3.Final</version>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>5.22.0</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.testng</groupId>
                <artifactId>testng</artifactId>
                <version>7.12.0</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>nl.jqno.equalsverifier</groupId>
                <artifactId>equalsverifier</artifactId>
                <version>4.4.1</version>
                <scope>test</scope>
            </dependency>
            <!-- Managed here so modules that need PrimeFaces opt in explicitly -->
            <dependency>
                <groupId>org.primefaces</groupId>
                <artifactId>primefaces</artifactId>
                <version>15.0.13</version>
                <classifier>jakarta</classifier>
            </dependency>
            <dependency>
                <groupId>jakarta.faces</groupId>
                <artifactId>jakarta.faces-api</artifactId>
                <version>4.1.2</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>org.glassfish</groupId>
                <artifactId>jakarta.faces</artifactId>
                <version>4.1.6</version>
                <scope>compile</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>jakarta.el</groupId>
            <artifactId>jakarta.el-api</artifactId>
            <version>6.0.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.44</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <source>25</source>
                    <target>25</target>
                    <release>25</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.44</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.0</version>
            </plugin>
            <plugin>
                <!--
                    Test coverage. The report is bound to `test`, not `verify`, so the everyday
                    `mvn test -pl trip` produces it with no extra command to remember:
                    trip/target/site/jacoco/index.html

                    prepare-agent sets the `argLine` property that surefire picks up. Nothing else here sets
                    argLine; if something ever does, it must append ${argLine} or coverage silently reports
                    zero for everything while the build still passes.

                    Accurate numbers depend on lombok.config's addLombokGeneratedAnnotation - without it the
                    generated equals/hashCode/toString/builder methods on every @Data model count as uncovered
                    and bury the real gaps.
                -->
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <!--
                        Every exclusion here was approved individually. Adding one is not a way to make the
                        coverage gate pass: if a class is hard to test, that is usually worth knowing.
                    -->
                    <excludes>
                        <!-- MapStruct-generated; the hand-written mapper interfaces are still measured. -->
                        <exclude>**/*MapperImpl.class</exclude>
                        <exclude>**/App.class</exclude>
                        <!--
                            Mojarra instantiates these through the JSF factory chain to override the server
                            name; constructing one outside a container means faking the whole factory stack for
                            three overrides. Covers TripFacesContext, its TripExternalContext inner class, and
                            TripFacesContextFactory.
                        -->
                        <exclude>**/TripFacesContext*.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
