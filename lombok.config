# This is the top of the trip repo; don't look for further lombok.config files above it.
config.stopBubbling = true

# Stamp @lombok.Generated on generated methods. JaCoCo skips anything so annotated, which is what keeps the
# coverage numbers meaningful: every model here is @Data/@Builder, so without this the generated
# equals/hashCode/toString/builder methods count as hundreds of uncovered lines and org.paulsens.trip.model
# reports terrible coverage that hides the real gaps. Affects annotations only - no behaviour change.
lombok.addLombokGeneratedAnnotation = true
