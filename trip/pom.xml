<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.paulsens</groupId>
        <artifactId>trip-manager-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>trip-manager</artifactId>
    <packaging>war</packaging>
    <name>Trip Organizer Web App</name>
    <url>http://18.236.22.94</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- One version for the mapstruct dependency and its processor; they must not drift. -->
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok.version>1.18.44</lombok.version>
        <!--
            The coverage gate's kill switch. False here so a laptop `mvn package` reports coverage shortfalls
            without failing the build; GitHub Actions passes -Djacoco.check.halt=true, which is where the gate
            actually blocks. Deliberately NOT enabled in the CodePipeline buildspec (it runs -DskipTests, a
            cost decision), so GitHub is the one place a coverage regression stops anything.
        -->
        <jacoco.check.halt>false</jacoco.check.halt>
    </properties>

    <dependencies>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>dynamodb</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>ses</artifactId>
        </dependency>
        <!-- Secrets Manager: source of the password pepper at startup. Uses the async (Netty) client so it
             reuses the http stack DynamoDB already pulls in, rather than adding the Apache sync client. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>secretsmanager</artifactId>
        </dependency>
        <!-- CloudWatch Logs: the audit trail ships to its own log group. A container-local file is not durable
             (the task's disk dies with it), and the app log group's short retention is wrong for an audit
             trail. Async (Netty) client, same http stack as the above. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>cloudwatchlogs</artifactId>
        </dependency>
        <!-- S3: managed media uploads from the admin UI. The app only ever WRITES here; visitors are served
             by CloudFront, so this is never in the read path for serving a page. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>
        <!-- CodePipeline: the admin Deploy page starts a release and shows its progress, so releasing does not
             need the AWS console. Read + start only; the task role grants nothing else. Synchronous client,
             like S3 above: both calls are user-initiated on a request thread that must report the outcome. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>codepipeline</artifactId>
        </dependency>
        <dependency>
            <groupId>at.favre.lib</groupId>
            <artifactId>bcrypt</artifactId>
        </dependency>
        <dependency>
            <groupId>io.lettuce</groupId>
            <artifactId>lettuce-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.paypal.sdk</groupId>
            <artifactId>paypal-server-sdk</artifactId>
            <version>2.2.0</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.1.0</version>
            <scope>provided</scope>
        </dependency>
        <!-- JAX-RS (Jersey) for /api/* — first piece of the REST direction; pin Jackson via parent BOM. -->
        <dependency>
            <groupId>org.glassfish.jersey.containers</groupId>
            <artifactId>jersey-container-servlet</artifactId>
            <version>3.1.10</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jersey.core</groupId>
            <artifactId>jersey-server</artifactId>
            <version>3.1.10</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jersey.media</groupId>
            <artifactId>jersey-media-json-jackson</artifactId>
            <version>3.1.10</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jersey.inject</groupId>
            <artifactId>jersey-hk2</artifactId>
            <version>3.1.10</version>
        </dependency>
        <!--
            MapStruct maps domain models to the api/dto records. Compile-time only: it generates plain Java, so
            it adds nothing to the runtime and needs no jlink module (contrast jdk.net, whose omission 500s any
            page touching S3). The processor itself is wired in annotationProcessorPaths below, NOT here.
        -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>
        <!--
            NOTE: jersey-test-framework is deliberately NOT a dependency. JerseyTest is JUnit 5 based, and
            pulling junit-jupiter onto this module's test classpath is what silently disabled the entire TestNG
            suite (see the surefire pin below). Resource behaviour is covered instead by TestNG tests against
            ChatCommands, which holds the logic, plus ChatFeedIT for the wiring, which is the split the design
            called for. Reintroducing JerseyTest means adding a second, JUnit-specific surefire execution on
            purpose.
        -->
        <dependency>
            <groupId>jakarta.faces</groupId>
            <artifactId>jakarta.faces-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.glassfish</groupId>
            <artifactId>jakarta.faces</artifactId>
        </dependency>
        <dependency>
            <groupId>com.sun.jsftemplating</groupId>
            <artifactId>jsft</artifactId>
            <version>4.1.2-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.primefaces</groupId>
            <artifactId>primefaces</artifactId>
            <classifier>jakarta</classifier>
        </dependency>
        <dependency>
            <groupId>org.primefaces.extensions</groupId>
            <artifactId>primefaces-extensions</artifactId>
            <version>15.0.13</version>
            <classifier>jakarta</classifier>
        </dependency>
        <dependency>
            <groupId>com.googlecode.libphonenumber</groupId>
            <artifactId>libphonenumber</artifactId>
            <version>9.0.24</version>
        </dependency>
        <dependency>
           <groupId>org.apache.poi</groupId>
           <artifactId>poi</artifactId>
            <version>5.5.1</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.5.1</version>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet.jsp.jstl</groupId>
            <artifactId>jakarta.servlet.jsp.jstl-api</artifactId>
            <version>3.0.2</version>
        </dependency>
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jboss.weld.servlet</groupId>
            <artifactId>weld-servlet-shaded</artifactId>
        </dependency>

        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
        </dependency>
        <dependency>
            <groupId>nl.jqno.equalsverifier</groupId>
            <artifactId>equalsverifier</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.github.fppt</groupId>
            <artifactId>jedis-mock</artifactId>
            <version>1.1.16</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.amazonaws</groupId>
            <artifactId>DynamoDBLocal</artifactId>
            <version>2.6.1</version>
            <scope>test</scope>
        </dependency>
        <!--
            DynamoDBLocal drags in log4j-core 2.17.1, while POI puts log4j-api 2.24.3 on the compile classpath.
            The mismatch is not a warning: log4j-core dies with NoSuchMethodError LoaderUtil.getClassLoaders()
            while DynamoDB Local is still starting, so every test using it fails in @BeforeClass.
        -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.24.3</version>
            <scope>test</scope>
        </dependency>
        <!--
            An EL IMPLEMENTATION, test scope only. jakarta.el-api on the compile classpath is just the API;
            ExpressionFactory.newInstance() needs a provider, which at runtime comes from Tomcat. Without this,
            anything exercising ELUtil.renderWithoutJsf (the email templates) fails in unit tests with
            "Provider not found" while working perfectly in the container.
            Test scope deliberately: adding an EL implementation to the WAR would put a second provider beside
            Tomcat's.
        -->
        <dependency>
            <groupId>org.glassfish</groupId>
            <artifactId>jakarta.el</artifactId>
            <version>4.0.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>ROOT</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <source>25</source>
                    <target>25</target>
                    <release>25</release>
                    <!--
                        Declaring annotationProcessorPaths HERE overrides the parent's (trip/pom.xml), it does
                        not add to it. Lombok is therefore re-listed explicitly: drop it and every @Getter in
                        the module vanishes and the build collapses.

                        Order is load-bearing. lombok-mapstruct-binding makes MapStruct wait for Lombok to
                        generate accessors; without it MapStruct runs first, sees a model class with no
                        getters, and emits a mapper that silently maps NOTHING. It compiles and the tests that
                        catch it are the round-trip ones.
                    -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>0.2.0</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <!--
                    Resolves each dependency's jar path into a property named after its coordinates, which is how
                    surefire's argLine above gets ${org.mockito:mockito-core:jar} without hard-coding a path or a
                    version.
                -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.9.0</version>
                <executions>
                    <execution>
                        <id>resolve-agent-paths</id>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!--
                    The TestNG provider is pinned EXPLICITLY. Surefire otherwise auto-detects a provider from
                    the test classpath, and the moment any dependency drags in JUnit (jersey-test-framework
                    brings junit-jupiter) it silently switches to the JUnit platform provider: every TestNG test
                    stops running, "Tests run: 0" scrolls past, and the build still reports SUCCESS. That
                    actually happened here; the whole suite went dark and nothing failed. Do not remove this
                    pin, and do not rely on auto-detection.
                -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.maven.surefire</groupId>
                        <artifactId>surefire-testng</artifactId>
                        <version>3.2.5</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <!--
                        @{argLine}, NOT ${argLine}. The '@' is surefire's late replacement, evaluated after
                        JaCoCo's prepare-agent has set the argLine property. With '$' the property is resolved
                        too early, JaCoCo's -javaagent is dropped, and every coverage figure silently reads zero
                        while the build stays green: the same shape of failure as the surefire provider note
                        below, and just as invisible.

                        The mockito agent is explicit because Mockito otherwise self-attaches at runtime, which
                        the JDK already warns about and will refuse in a future release. This suite leans on
                        mockStatic heavily (every api resource test), so that is not a warning to sit on.
                    -->
                    <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
                    <!-- A run that finds no tests is a broken run, not a passing one. -->
                    <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
                    <systemPropertyVariables>
                        <!--
                            Unit tests have no servlet container, so nothing can read the "local" init-param that
                            decides this in a deployment. Local mode is opt-in and defaults to OFF (see LocalMode),
                            so the test JVM has to ask for it explicitly - and asking here means it cannot be
                            forgotten by an individual test and cannot leak into a deployed artifact.

                            Without this, DAO.getInstance() would build a real DynamoPersistence and the suite
                            would reach for AWS.
                        -->
                        <trip.local.mode>true</trip.local.mode>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <!--
                    The coverage GATE (the report itself is configured in the parent). Two rules, both on LINE
                    coverage: the bundle must hold 90%, and every individual class must hold 90%. The
                    per-class floor is the half that catches a new, simple, untested class before production,
                    which the overall number alone would absorb without a ripple.

                    Bound to `test` (not `verify`) because CI runs `mvn package`, which never reaches verify.
                    haltOnFailure comes from ${jacoco.check.halt}: false locally, true in GitHub Actions.

                    Every name on the exclusion list was approved individually on 2026-08-03; each is excluded
                    from the PER-CLASS rule only and still counts toward the bundle number. Adding a name here
                    is not a way to make the gate pass.
                -->
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>coverage-gate</id>
                        <phase>test</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <haltOnFailure>${jacoco.check.halt}</haltOnFailure>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <excludes>
                                        <!-- FacesContext-bound UI helpers; the chat rules themselves are tested. -->
                                        <exclude>org.paulsens.trip.action.ChatCommands</exclude>
                                        <!-- main() constructs a real DynamoPersistence; the sweep logic is tested. -->
                                        <exclude>org.paulsens.trip.dynamo.PasswordMigration</exclude>
                                        <!-- The cluster constructor needs a real cluster; see ValkeyClusterPubSubTest. -->
                                        <exclude>org.paulsens.trip.cache.ValkeyCacheClient</exclude>
                                        <!-- The public constructor creates a real CloudWatch log stream. -->
                                        <exclude>org.paulsens.trip.audit.CloudWatchAuditSink</exclude>
                                        <!-- The lazy s3()/regionName() builders reach real AWS if invoked. -->
                                        <exclude>org.paulsens.trip.action.MediaCommands</exclude>
                                        <!-- The Secrets Manager SUCCESS path needs a live secret; failures are tested. -->
                                        <exclude>org.paulsens.trip.security.Pepper</exclude>
                                        <!-- Queue-full/interrupt branches require racing the writer thread. -->
                                        <exclude>org.paulsens.trip.audit.DynamoAuditSink</exclude>
                                    </excludes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.5.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>org.paulsens.trip.App</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
