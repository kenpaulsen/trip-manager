  {
    "name": "metrics",
    "title": "Metrics",
    "titles": {
      "es": "Métricas",
      "hr": "Metrike"
    },
    "placement": "HIDDEN",
    "access": "SITE_ADMINS",
    "everySite": true,
    "sidebar": "HIDE",
    "rows": [
      {
        "slot": "intro",
        "title": "Metrics",
        "templateId": "text-only",
        "values": {
          "body": "<h2>Metrics</h2><p>How this site's servers behaved over the last week, minute by minute: choose a tile to see it in full below. Only site admins see this page. Open its edit mode to add, remove, resize or change a graph. <a href=\"/admin/orgSettings.jsf?orgId={orgId}\">Back to the organization</a></p>"
        }
      },
      {
        "slot": "graphs",
        "title": "",
        "templateId": "graph-grid",
        "values": {},
        "allowedChildTemplateIds": [
          "metric-graph"
        ],
        "children": [
          {
            "slot": "pool",
            "title": "DynamoDB connections in use",
            "templateId": "metric-graph",
            "values": {
              "metric": "ddb.pool:max",
              "width": "1",
              "height": "1",
              "headline": "yes",
              "controls": "none",
              "showsIn": "focus",
              "style": "area",
              "warnAt": "160"
            }
          },
          {
            "slot": "pending",
            "title": "Calls waiting for a DynamoDB connection",
            "templateId": "metric-graph",
            "values": {
              "metric": "ddb.pool:pending",
              "width": "1",
              "height": "1",
              "headline": "yes",
              "controls": "none",
              "showsIn": "focus",
              "style": "line"
            }
          },
          {
            "slot": "requests",
            "title": "Requests",
            "templateId": "metric-graph",
            "values": {
              "metric": "http.requests:count",
              "width": "1",
              "height": "1",
              "headline": "yes",
              "controls": "none",
              "showsIn": "focus",
              "style": "bars"
            }
          },
          {
            "slot": "errors",
            "title": "Server errors",
            "templateId": "metric-graph",
            "values": {
              "metric": "http.requests:errors",
              "width": "1",
              "height": "1",
              "headline": "yes",
              "controls": "none",
              "showsIn": "focus",
              "style": "bars"
            }
          },
          {
            "slot": "slowest",
            "title": "Slowest request",
            "templateId": "metric-graph",
            "values": {
              "metric": "http.requests:maxMs",
              "width": "1",
              "height": "1",
              "headline": "yes",
              "controls": "none",
              "showsIn": "focus",
              "style": "line"
            }
          },
          {
            "slot": "active",
            "title": "Requests in flight, peak",
            "templateId": "metric-graph",
            "values": {
              "metric": "http.requests:active",
              "width": "1",
              "height": "1",
              "headline": "yes",
              "controls": "none",
              "showsIn": "focus",
              "style": "line"
            }
          },
